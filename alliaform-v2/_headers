# En-têtes HTTP (Cloudflare et Netlify)
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), microphone=(), geolocation=()

# Polices et images : mises en cache longtemps par les navigateurs
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
/assets/*
  Cache-Control: public, max-age=2592000

# Adresses provisoires en *.workers.dev : pas d'indexation par Google
# (seul alliaform.fr doit apparaître dans les résultats)
https://:worker.:subdomain.workers.dev/*
  X-Robots-Tag: noindex
