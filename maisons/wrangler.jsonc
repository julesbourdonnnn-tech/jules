// Configuration Cloudflare du site Sable & Pierre (Worker « lacanau »),
// séparé de Nuits Singulières. Le site est servi tel quel depuis ce dossier.
// Mise en ligne : voir README.md (Cloudflare Workers Builds, répertoire racine
// « maisons »), ou à la main depuis ce dossier : npx wrangler deploy
{
  "name": "lacanau",
  "compatibility_date": "2025-09-01",
  // Petit programme pour le calendrier et les demandes (worker/index.js) :
  // il s'exécute pour les adresses /api/* et les pages (images de partage),
  // le reste (photos, styles, scripts) est servi directement.
  "main": "worker/index.js",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*", "/", "/*.html", "/lacanau", "/bordeaux", "/mentions-legales"]
  },
  // Stockage des demandes de réservation directe. Pour l'activer :
  // 1. Cloudflare → Stockage et bases de données → KV → Créer « sable-et-pierre-demandes »
  // 2. Copier son identifiant ci-dessous et retirer les // devant les 3 lignes.
  // Tant que ce n'est pas fait, le formulaire ouvre un e-mail pré-rempli.
  // "kv_namespaces": [
  //   { "binding": "DEMANDES", "id": "COLLE_ICI_L_IDENTIFIANT" }
  // ],
  // Nom de domaine : une fois acheté sur Cloudflare, retirer les // ci-dessous.
  // "routes": [
  //   { "pattern": "mon-domaine.fr", "custom_domain": true },
  //   { "pattern": "www.mon-domaine.fr", "custom_domain": true }
  // ],
  "workers_dev": true
}
