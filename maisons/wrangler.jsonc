// Configuration Cloudflare du site Sable & Pierre (Worker « lacanau »),
// séparé de Nuits Singulières. Le site est servi tel quel depuis ce dossier.
// Mise en ligne : voir README.md (Cloudflare Workers Builds, répertoire racine
// « maisons »), ou à la main depuis ce dossier : npx wrangler deploy
{
  "name": "lacanau",
  "compatibility_date": "2025-09-01",
  // Petit programme pour le calendrier et les demandes (worker/index.js) :
  // il s'exécute pour les adresses /api/* et les pages (images de partage),
  // le reste (photos, styles, scripts) est servi directement.
  "main": "worker/index.js",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*", "/", "/*.html", "/lacanau", "/bordeaux", "/mentions-legales", "/conditions", "/vacances-famille-lacanau", "/vacances-famille-bordeaux"]
  },
  // Stockage des réservations directes (créé le 2 octobre 2026)
  "kv_namespaces": [
    { "binding": "RESERVATIONS", "id": "740e12d73b574596957cb3fb964f72c9" }
  ],
  // Mesure d'audience anonyme (visites, sources, clics) affichée dans admin.html
  "d1_databases": [
    { "binding": "STATS", "database_name": "sable-et-pierre-stats", "database_id": "749aadc7-2bdd-4425-8459-ddc62a6c8d43" }
  ],
  // E-mail au propriétaire à chaque réservation (Cloudflare Email Routing, adresse vérifiée)
  "send_email": [
    { "name": "MAILER", "destination_address": "contact.sablepierre@gmail.com" }
  ],
  // Nom de domaine (acheté sur Cloudflare le 8 octobre 2026) ; www renvoie vers l'adresse sans www
  "routes": [
    { "pattern": "sable-et-pierre.com", "custom_domain": true },
    { "pattern": "www.sable-et-pierre.com", "custom_domain": true }
  ],
  "workers_dev": true
}
