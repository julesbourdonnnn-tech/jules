leItems": [], "channel": null, "reviewMediaItems": [], "isHostHighlightedReview": null, "reviewPhotoUrls": []}, {"__typename": "PdpReviewForP3", "collectionTag": null, "comments": "Merci à nos hôtes pour ce super accueil dans cette superbe maison. <br/>Nous avons passé un excellent séjour, c’est une maison chaleureuse, décorée avec goût par les propriétaires et très fonctionnelle. <br/>Je vous la recommande les yeux fermés. <br/>Encore merci :)", "id": "791100006256905162", "language": "fr", "createdAt": "2022-12-27T12:14:29Z", "reviewee": {"__typename": "ReviewUser", "deleted": false, "firstName": "Charlene", "hostName": "Charlene", "id": "400141798", "pictureUrl": "https://a0.muscache.com/im/pictures/user/05bc5c1c-e98e-4e63-be62-d9c4b535177f.jpg", "profilePath": "/users/profile/1469837611424668015", "isSuperhost": false, "userProfilePicture": {"__typename": "Image", "baseUrl": "https://a0.muscache.com/im/pictures/user/05bc5c1c-e98e-4e63-be62-d9c4b535177f.jpg", "onPressAction": {"__typename": "NavigateToUserProfile", "url": "/users/profile/1469837611424668015"}}}, "reviewer": {"__typename": "ReviewUser", "deleted": false, "firstName": "Auriane", "hostName": "Auriane", "id": "54378591", "pictureUrl": "https://a0.muscache.com/im/pictures/user/1bd2d4a4-beea-4096-acf4-6edefbcc2e33.jpg", "profilePath": "/users/profile/1475734506207433914", "isSuperhost": false, "userProfilePicture": {"__typename": "Image", "baseUrl": "https://a0.muscache.com/im/pictures/user/1bd2d4a4-beea-4096-acf4-6edefbcc2e33.jpg", "onPressAction": {"__typename": "NavigateToUserProfile", "url": "/users/profile/1475734506207433914"}}}, "reviewHighlight": "Séjour de quelques nuits", "highlightType": "LENGTH_OF_STAY", "localizedDate": "décembre 2022", "localizedRespondedDate": null, "localizedReviewerLocation": "11 ans sur Airbnb", "localizedReview": null, "rating": 5, "ratingAccessibilityLabel": "Évaluation 5 étoiles", "recommendedNumberOfLines": null, "response": null, "roomTypeListingTitle": null, "highlightedReviewSentence": [], "highlightReviewMentioned": null, "showMoreButton": {"__typename": "BasicListItem", "title": "Lire la suite", "loggingEventData": {"__typename": "LoggingEventData", "loggingId": "pdp.reviews.readMore", "experiments": [], "eventData": null, "eventDataSchemaName": null, "section": null, "component": null}}, "subtitleItems": [], "channel": null, "reviewMediaItems": [], "isHostHighlightedReview": null, "reviewPhotoUrls": []}, {"__typename": "PdpReviewForP3", "collectionTag": null, "comments": "Nous parcourons parfois des centaines voir des milliers de kilomètre pour se dépayser, j'ai juste fait quelques kilomètres pour me retrouver dans un havre de paix. <br/>La décoration simple, mais très bien pensée vous transporte dans un autre lieu, loin de chez vous. Dépaysement instantané dans ce cocon familial. <br/>Equipement de la maison et du jardin au top. Il ne manquait que la livraison de nourriture.<br/> Environnement calme, on pourrait presque ne pas sortir grâce à la piscine tellement on s'y sent bien. <br/>Un accueil chaleureux avec une petite attention (ce qui fait toujours plaisir), une prise de nouvelle durant le séjour par Charlène.  Que dire...expérience à renouveler ! <br/>Merci Charlène, votre maison est vraiment magnifique et magique !", "id": "702720147663684848", "language": "fr", "createdAt": "2022-08-27T13:39:29Z", "reviewee": {"__typename": "ReviewUser", "deleted": false, "firstName": "Charlene", "hostName": "Charlene", "id": "400141798", "pictureUrl": "https://a0.muscache.com/im/pictures/user/05bc5c1c-e98e-4e63-be62-d9c4b535177f.jpg", "profilePath": "/users/profile/1469837611424668015", "isSuperhost": false, "userProfilePicture": {"__typename": "Image", "baseUrl": "https://a0.muscache.com/im/pictures/user/05bc5c1c-e98e-4e63-be62-d9c4b535177f.jpg", "onPressAction": {"__typename": "NavigateToUserProfile", "url": "/users/profile/1469837611424668015"}}}, "reviewer": {"__typename": "ReviewUser", "deleted": false, "firstName": "Sandrine", "hostName": "Sandrine", "id": "387595645", "pictureUrl": "https://a0.muscache.com/im/pictures/user/User/original/7744c258-c5f4-4efd-aa00-98a20f58704a.jpeg", "profilePath": "/users/profile/1478459754639540159", "isSuperhost": false, "userProfilePicture": {"__typename": "Image", "baseUrl": "https://a0.muscache.com/im/pictures/user/User/original/7744c258-c5f4-4efd-aa00-98a20f58704a.jpeg", "onPressAction": {"__typename": "NavigateToUserProfile", "url": "/users/profile/1478459754639540159"}}}, "reviewHighlight": "Séjour de quelques nuits", "highlightType": "LENGTH_OF_STAY", "localizedDate": "août 2022", "localizedRespondedDate": null, "localizedReviewerLocation": "6 ans sur Airbnb", "localizedReview": null, "rating": 5, "ratingAccessibilityLabel": "Évaluation 5 étoiles", "recommendedNumberOfLines": null, "response": null, "roomTypeListingTitle": null, "highlightedReviewSentence": [], "highlightReviewMentioned": null, "showMoreButton": {"__typename": "BasicListItem", "title": "Lire la suite", "loggingEventData": {"__typename": "LoggingEventData", "loggingId": "pdp.reviews.readMore", "experiments": [], "eventData": null, "eventDataSchemaName": null, "section": null, "component": null}}, "subtitleItems": [], "channel": null, "reviewMediaItems": [], "isHostHighlightedReview": null, "reviewPhotoUrls": []}, {"__typename": "PdpReviewForP3", "collectionTag": null, "comments": "Charlène et son mari sont très chaleureux et accueillants : tout est fait pour que vous vous sentiez immédiatement chez vous; <br/>La maison est superbe, décorée avec beaucoup de gout, très confortable et spacieuse;  Quiétude et confort en synthèse; <br/>La maison est très bien équipée et la literie d'excellentes qualités;<br/>Vous traversez la route et vous êtes au lac ... <br/>A recommander sans hésitation donc", "id": "695398572324349235", "language": "fr", "createdAt": "2022-08-17T11:12:49Z", "reviewee": {"__typename": "ReviewUser", "deleted": false, "firstName": "Charlene", "hostName": "Charlene", "id": "400141798", "pictureUrl": "https://a0.muscache.com/im/pictures/user/05bc5c1c-e98e-4e63-be62-d9c4b535177f.jpg", "profilePath": "/users/profile/1469837611424668015", "isSuperhost": false, "userProfilePicture": {"__typename": "Image", "baseUrl": "https://a0.muscache.com/im/pictures/user/05bc5c1c-e98e-4e63-be62-d9c4b535177f.jpg", "onPressAction": {"__typename": "NavigateToUserProfile", "url": "/users/profile/1469837611424668015"}}}, "reviewer": {"__typename": "ReviewUser", "deleted": false, "firstName": "Fanny", "hostName": "Fanny", "id": "206828554", "pictureUrl": "https://a0.muscache.com/im/pictures/user/d7571285-3372-41d3-837e-9c35ac9db335.jpg", "profilePath": "/users/profile/1475535277568998393", "isSuperhost": false, "userProfilePicture": {"__typename": "Image", "baseUrl": "https://a0.muscache.com/im/pictures/user/d7571285-3372-41d3-837e-9c35ac9db335.jpg", "onPressAction": {"__typename": "NavigateToUserProfile", "url": "/users/profile/1475535277568998393"}}}, "reviewHighlight": "Séjour d'environ une semaine", "highlightType": "LENGTH_OF_STAY", "localizedDate": "août 2022", "localizedRespondedDate": null, "localizedReviewerLocation": "8 ans sur Airbnb", "localizedReview": null, "rating": 5, "ratingAccessibilityLabel": "Évaluation 5 étoiles", "recommendedNumberOfLines": null, "response": null, "roomTypeListingTitle": null, "highlightedReviewSentence": [], "highlightReviewMentioned": null, "showMoreButton": {"__typename": "BasicListItem", "title": "Lire la suite", "loggingEventData": {"__typename": "LoggingEventData", "loggingId": "pdp.reviews.readMore", "experiments": [], "eventData": null, "eventDataSchemaName": null, "section": null, "component": null}}, "subtitleItems": [], "channel": null, "reviewMediaItems": [], "isHostHighlightedReview": null, "reviewPhotoUrls": []}, {"__typename": "PdpReviewForP3", "collectionTag": null, "comments": "Hôtes super accueillant ! Maison géniale, bien équipée et bien située à 100m du lac du Moutchic !<br/>Très calme, idéal pour quelques jours en famille !", "id": "680174899176418527", "language": "fr", "createdAt": "2022-07-27T11:06:06Z", "reviewee": {"__typename": "ReviewUser", "deleted": false, "firstName": "Charlene", "hostName": "Charlene", "id": "400141798", "pictureUrl": "https://a0.muscache.com/im/pictures/user/05bc5c1c-e98e-4e63-be62-d9c4b535177f.jpg", "profilePath": "/users/profile/1469837611424668015", "isSuperhost": false, "userProfilePicture": {"__typename": "Image", "baseUrl": "https://a0.muscache.com/im/pictures/user/05bc5c1c-e98e-4e63-be62-d9c4b535177f.jpg", "onPressAction": {"__typename": "NavigateToUserProfile", "url": "/users/profile/1469837611424668015"}}}, "reviewer": {"__typename": "ReviewUser", "deleted": false, "firstName": "Gil", "hostName": "Gil", "id": "11820421", "pictureUrl": "https://a0.muscache.com/im/pictures/user/2b341339-fd36-47d1-a17e-dfb427510b25.jpg", "profilePath": "/users/profile/1478809355049516745", "isSuperhost": false, "userProfilePicture": {"__typename": "Image", "baseUrl": "https://a0.muscache.com/im/pictures/user/2b341339-fd36-47d1-a17e-dfb427510b25.jpg", "onPressAction": {"__typename": "NavigateToUserProfile", "url": "/users/profile/1478809355049516745"}}}, "reviewHighlight": "Séjour de quelques nuits", "highlightType": "LENGTH_OF_STAY", "localizedDate": "juillet 2022", "localizedRespondedDate": null, "localizedReviewerLocation": "13 ans sur Airbnb", "localizedReview": null, "rating": 5, "ratingAccessibilityLabel": "Évaluation 5 étoiles", "recommendedNumberOfLines": null, "response": null, "roomTypeListingTitle": null, "highlightedReviewSentence": [], "highlightReviewMentioned": null, "showMoreButton": {"__typename": "BasicListItem", "title": "Lire la suite", "loggingEventData": {"__typename": "LoggingEventData", "loggingId": "pdp.reviews.readMore", "experiments": [], "eventData": null, "eventDataSchemaName": null, "section": null, "component": null}}, "subtitleItems": [], "channel": null, "reviewMediaItems": [], "isHostHighlightedReview": null, "reviewPhotoUrls": []}, {"__typename": "PdpReviewForP3", "collectionTag": null, "comments": "Charlène et son compagnon nous ont chaleureusement accueillis. Ils ont veillé à ce que notre arrivée et notre départ se déroulent dans les meilleures conditions possibles. Leur résidence est très bien située puisqu'elle se trouve à moins de 10 min de l'océan en voiture et à 2 min à pieds du lac. Sur place, nous avons bénéficié de plusieurs équipements haut de gamme (cuisine équipée, wi-fi, barbecue, piscine éclairée avec robot nettoyant, etc.) ainsi que d'un ameublement très complet et d'une décoration raffinée et harmonieuse. L'ensemble, en parfait état et d'une propreté impeccable, nous a permis de jouir d'un confort de vie exceptionnel. La piscine extérieure, très agréable et rafraîchissante à toute heure de la journée, est bordée par un aménagement de plantes à feuillage verdoyant faisant vivre un jardin spacieux et paisible. Enfin, la grande table en terrasse est idéale pour profiter de tous les repas de la journée. Nous nous sommes donc sentis véritablement en vacances dans un endroit familial et chaleureux. Je recommande très chaudement cette résidence !", "id": "672991130183600840", "language": "fr", "createdAt": "2022-07-17T13:13:14Z", "reviewee": {"__typename": "ReviewUser", "deleted": false, "firstName": "Charlene", "hostName": "Charlene", "id": "400141798", "pictureUrl": "https://a0.muscache.com/im/pictures/user/05bc5c1c-e98e-4e63-be62-d9c4b535177f.jpg", "profilePath": "/users/profile/1469837611424668015", "isSuperhost": false, "userProfilePicture": {"__typename": "Image", "baseUrl": "https://a0.muscache.com/im/pictures/user/05bc5c1c-e98e-4e63-be62-d9c4b535177f.jpg", "onPressAction": {"__typename": "NavigateToUserProfile", "url": "/users/profile/1469837611424668015"}}}, "reviewer": {"__typename": "ReviewUser", "deleted": false, "firstName": "Gaspard", "hostName": "Gaspard", "id": "248447206", "pictureUrl": "https://a0.muscache.com/im/pictures/user/9857