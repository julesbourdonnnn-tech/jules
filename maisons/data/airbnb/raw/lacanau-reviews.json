[{"__typename": "PdpReviewForP3", "collectionTag": null, "comments": "Der ganze Aufenthalt hat von vorne bis hinten wunderbar gepasst. Charlene ist eine tolle Gastgeberin und das Haus ist sehr geschmackvoll und umfangreich eingerichtet. Wir haben uns als Familie dort sehr wohl gefühlt. Alles ist sehr individuell eingerichtet und die Lage des Hauses ist einfach perfekt. In der Nähe gibt es Restaurants und der See ist ein paar Meter entfernt. Hier können die Unterkunft und die Gastgeber nur empfehlen.", "id": "1494211970720598543", "language": "de", "createdAt": "2025-08-23T14:52:27Z", "reviewee": {"__typename": "ReviewUser", "deleted": false, "firstName": "Charlene", "hostName": "Charlene", "id": "400141798", "pictureUrl": "https://a0.muscache.com/im/pictures/user/05bc5c1c-e98e-4e63-be62-d9c4b535177f.jpg", "profilePath": "/users/profile/1469837611424668015", "isSuperhost": false, "userProfilePicture": {"__typename": "Image", "baseUrl": "https://a0.muscache.com/im/pictures/user/05bc5c1c-e98e-4e63-be62-d9c4b535177f.jpg", "onPressAction": {"__typename": "NavigateToUserProfile", "url": "/users/profile/1469837611424668015"}}}, "reviewer": {"__typename": "ReviewUser", "deleted": false, "firstName": "Christian", "hostName": "Christian", "id": "18123599", "pictureUrl": "https://a0.muscache.com/im/pictures/user/53c8b467-e07f-4269-af01-2cb5d6a3e112.jpg", "profilePath": "/users/profile/1479021018313019047", "isSuperhost": false, "userProfilePicture": {"__typename": "Image", "baseUrl": "https://a0.muscache.com/im/pictures/user/53c8b467-e07f-4269-af01-2cb5d6a3e112.jpg", "onPressAction": {"__typename": "NavigateToUserProfile", "url": "/users/profile/1479021018313019047"}}}, "reviewHighlight": "Séjour d'environ une semaine", "highlightType": "LENGTH_OF_STAY", "localizedDate": "août 2025", "localizedRespondedDate": null, "localizedReviewerLocation": "12 ans sur Airbnb", "localizedReview": {"__typename": "LocalizedReview", "comments": "Tout le séjour s'est merveilleusement bien passé du début à la fin. Charlene est une super hôtesse et la maison est décorée avec beaucoup de goût et de manière complète. Nous nous y sommes sentis très à l'aise en tant que famille. Tout est aménagé de manière très individuelle et l'emplacement de la maison est tout simplement parfait. Il y a des restaurants à proximité et le lac est à quelques mètres. Ici, nous ne pouvons que recommander le logement et les hôtes.", "commentsLanguage": "de", "disclaimer": "Langue d'origine : Allemand", "needsTranslation": true, "response": null, "responseDisclaimer": null}, "rating": 5, "ratingAccessibilityLabel": "Évaluation 5 étoiles", "recommendedNumberOfLines": null, "response": null, "roomTypeListingTitle": null, "highlightedReviewSentence": [], "highlightReviewMentioned": null, "showMoreButton": {"__typename": "BasicListItem", "title": "Lire la suite", "loggingEventData": {"__typename": "LoggingEventData", "loggingId": "pdp.reviews.readMore", "experiments": [], "eventData": null, "eventDataSchemaName": null, "section": null, "component": null}}, "subtitleItems": [], "channel": null, "reviewMediaItems": [], "isHostHighlightedReview": null, "reviewPhotoUrls": []}, {"__typename": "PdpReviewForP3", "collectionTag": null, "comments": "We had an absolutely wonderful time staying at Charlene’s home! From the moment we arrived, everything was exactly as described, if not better. The house was spotless, beautifully decorated, and had all the little touches that made it feel like home (fresh towels, amazing welcome pack, local recommendations).<br/>We are a family of 11 (8 Adults & 3 Children ages 2 & 7). The location was perfect! Quiet, very safe, and close to everything we needed. Whether you're looking to explore, swim in the lake, go wild at the splash park or just relax by the pool, this is the perfect spot.<br/>There are some great restaurants nearby which cater for all needs and tastes and if you fancy traveling to the Ocean then there are lots of buses if you don’t have a car! <br/>Most importantly, the host was outstanding. Communication was quick, kind, and helpful throughout our stay. They truly went above and beyond to make sure we were comfortable.<br/>We would 100% stay here again and recommend it without hesitation.", "id": "1476821086125594440", "language": "en", "createdAt": "2025-07-30T14:59:52Z", "reviewee": {"__typename": "ReviewUser", "deleted": false, "firstName": "Charlene", "hostName": "Charlene", "id": "400141798", "pictureUrl": "https://a0.muscache.com/im/pictures/user/05bc5c1c-e98e-4e63-be62-d9c4b535177f.jpg", "profilePath": "/users/profile/1469837611424668015", "isSuperhost": false, "userProfilePicture": {"__typename": "Image", "baseUrl": "https://a0.muscache.com/im/pictures/user/05bc5c1c-e98e-4e63-be62-d9c4b535177f.jpg", "onPressAction": {"__typename": "NavigateToUserProfile", "url": "/users/profile/1469837611424668015"}}}, "reviewer": {"__typename": "ReviewUser", "deleted": false, "firstName": "Gareth", "hostName": "Gareth", "id": "183851399", "pictureUrl": "https://a0.muscache.com/im/pictures/user/User/original/de6ed38d-a301-4446-bf30-fd3352d824b4.jpeg", "profilePath": "/users/profile/1474231544590442794", "isSuperhost": false, "userProfilePicture": {"__typename": "Image", "baseUrl": "https://a0.muscache.com/im/pictures/user/User/original/de6ed38d-a301-4446-bf30-fd3352d824b4.jpeg", "onPressAction": {"__typename": "NavigateToUserProfile", "url": "/users/profile/1474231544590442794"}}}, "reviewHighlight": "Séjour d'environ une semaine", "highlightType": "LENGTH_OF_STAY", "localizedDate": "juillet 2025", "localizedRespondedDate": null, "localizedReviewerLocation": "8 ans sur Airbnb", "localizedReview": {"__typename": "LocalizedReview", "comments": "Nous avons passé un merveilleux séjour chez Charlene ! Dès notre arrivée, tout était exactement tel que décrit, voire mieux encore. La maison était impeccable, joliment décorée et avait toutes les petites attentions qui faisaient qu'on se sentait comme chez soi (serviettes fraîches, pack de bienvenue incroyable, recommandations locales).<br/>Nous sommes une famille de 11 personnes (8 adultes et 3 enfants âgés de 2 et 7 ans). L'emplacement était parfait ! Calme, très sûr et proche de tout ce dont nous avions besoin. Que vous cherchiez à explorer, à nager dans le lac, à vous amuser au parc aquatique ou tout simplement à vous détendre au bord de la piscine, c'est l'endroit idéal.<br/>Il y a de très bons restaurants à proximité qui répondent à tous les besoins et à tous les goûts et si vous avez envie de voyager vers l'océan, il y a beaucoup de bus si vous n'avez pas de voiture ! <br/>Plus important encore, l'hôte était exceptionnel. La communication a été rapide, aimable et utile tout au long de notre séjour. Ils ont vraiment fait tout pour que nous soyons à l'aise.<br/>Nous reviendrions ici à 100 % et le recommandons sans hésiter.", "commentsLanguage": "en", "disclaimer": "Langue d'origine : Anglais", "needsTranslation": true, "response": null, "responseDisclaimer": null}, "rating": 5, "ratingAccessibilityLabel": "Évaluation 5 étoiles", "recommendedNumberOfLines": null, "response": null, "roomTypeListingTitle": null, "highlightedReviewSentence": [], "highlightReviewMentioned": null, "showMoreButton": {"__typename": "BasicListItem", "title": "Lire la suite", "loggingEventData": {"__typename": "LoggingEventData", "loggingId": "pdp.reviews.readMore", "experiments": [], "eventData": null, "eventDataSchemaName": null, "section": null, "component": null}}, "subtitleItems": [], "channel": null, "reviewMediaItems": [], "isHostHighlightedReview": null, "reviewPhotoUrls": []}, {"__typename": "PdpReviewForP3", "collectionTag": null, "comments": "Excellent hosts with a beautiful holiday home. The lake is so close that it makes for a very relaxed holiday in this beautiful part of the world. They were always available to answer questions and help out. There are plenty of wine glasses etc. for a big group such as ours. Safe, secure and relaxed. Strong recommend.", "id": "1217329485574004527", "language": "en", "createdAt": "2024-08-06T14:16:23Z", "reviewee": {"__typename": "ReviewUser", "deleted": false, "firstName": "Charlene", "hostName": "Charlene", "id": "400141798", "pictureUrl": "https://a0.muscache.com/im/pictures/user/05bc5c1c-e98e-4e63-be62-d9c4b535177f.jpg", "profilePath": "/users/profile/1469837611424668015", "isSuperhost": false, "userProfilePicture": {"__typename": "Image", "baseUrl": "https://a0.muscache.com/im/pictures/user/05bc5c1c-e98e-4e63-be62-d9c4b535177f.jpg", "onPressAction": {"__typename": "NavigateToUserProfile", "url": "/users/profile/1469837611424668015"}}}, "reviewer": {"__typename": "ReviewUser", "deleted": false, "firstName": "Hannah", "hostName": "Hannah", "id": "267997393", "pictureUrl": "https://a0.muscache.com/im/pictures/user/cbe3af86-c3c5-4c0c-b6fa-acb1bd49c3ec.jpg", "profilePath": "/users/profile/1481080252952890400", "isSuperhost": false, "userProfilePicture": {"__typename": "Image", "baseUrl": "https://a0.muscache.com/im/pictures/user/cbe3af86-c3c5-4c0c-b6fa-acb1bd49c3ec.jpg", "onPressAction": {"__typename": "NavigateToUserProfile", "url": "/users/profile/1481080252952890400"}}}, "reviewHighlight": "Séjour d'environ une semaine", "highlightType": "LENGTH_OF_STAY", "localizedDate": "août 2024", "localizedRespondedDate": null, "localizedReviewerLocation": "7 ans sur Airbnb", "localizedReview": {"__typename": "LocalizedReview", "comments": "Excellents hôtes avec une belle maison de vacances. Le lac est si proche que cela permet de passer des vacances très relaxantes dans cette belle région. Ils étaient toujours disponibles pour répondre aux questions et aider. Vous y trouverez de nombreux verres à vin, etc. pour un grand groupe comme le nôtre. Sûr, sécurisé et détendu. Fortement recommandé.", "commentsLanguage": "en", "disclaimer": "Langue d'origine : Anglais", "needsTranslation": true, "response": null, "responseDisclaimer": null}, "rating": 5, "ratingAccessibilityLabel": "Évaluation 5 étoiles", "recommendedNumberOfLines": null, "response": null, "roomTypeListingTitle": null, "highlightedReviewSentence": [], "highlightReviewMentioned": null, "showMoreButton": {"__typename": "BasicListItem", "title": "Lire la suite", "loggingEventData": {"__typename": "LoggingEventData", "loggingId": "pdp.reviews.readMore", "experiments": [], "eventData": null, "eventDataSchemaName": null, "section": null, "component": null}}, "subtitleItems": [], "channel": null, "reviewMediaItems": [], "isHostHighlightedReview": null, "reviewPhotoUrls": []}, {"__typename": "PdpReviewForP3", "collectionTag": null, "comments": "The house exceeded what was stated in the advert and Charlene and Jann were brilliant hosts. They were super responsive and always willing to help - they gave us phone numbers and responded within minutes if we had a question. The house felt like a real luxurious stay and the location was perfect for both Lacanau Lake and also Lacanau Ocean. There were great beach spots within 5 minutes drive as well as supermarkets and Lacanau Ocean town really close. The lake was a 2 minute walk too. The house was brilliant for a family with kids and we used the pool and outside seating areas all the time. We loved it and would definitely stay again.", "id": "962156964357274869", "language": "en", "createdAt": "2023-08-20T12:34:08Z", "reviewee": {"__typename": "ReviewUser", "deleted": false, "firstName": "Charlene", "hostName": "Charlene", "id": "400141798", "pictureUrl": "https://a0.muscache.com/im/pictures/user/05bc5c1c-e98e-4e63-be62-d9c4b535177f.jpg", "profilePath": "/users/profile/1469837611424668015", "isSuperhost": false, "userProfilePicture": {"__typename": "Image", "baseUrl": "https://a0.muscache.com/im/pictures/user/05bc5c1c-e98e-4e63-be62-d9c4b535177f.jpg", "onPressAction": {"__typename": "NavigateToUserProfile", "url": "/users/profile/1469837611424668015"}}}, "reviewer": {"__typename": "ReviewUser", "deleted": false, "firstName": "Alan", "hostName": "Alan", "id": "22467288", "pictureUrl": "https://a0.muscache.com/im/pictures/user/d8f075c7-a6fc-4350-bae9-31eaf5489703.jpg", "profilePath": "/users/profile/1473939554312179475", "isSuperhost": false, "userProfilePicture": {"__typename": "Image", "baseUrl": "https://a0.muscache.com/im/pictures/user/d8f075c7-a6fc-4350-bae9-31eaf5489703.jpg", "onPressAction": {"__typename": "NavigateToUserProfile", "url": "/users/profile/1473939554312179475"}}}, "reviewHighlight": "Séjour de quelques nuits", "highlightType": "LENGTH_OF_STAY", "localizedDate": "août 2023", "localizedRespondedDate": "août 2023", "localizedReviewerLocation": "12 ans sur Airbnb", "localizedReview": {"__typename": "LocalizedReview", "comments": "La maison a dépassé ce qui était indiqué dans l'annonce et Charlene et Jann ont été des hôtes brillants. Ils ont été super réactifs et toujours prêts à aider – ils nous ont donné des numéros de téléphone et ont répondu en quelques minutes si nous avions une question. La maison ressemblait à un vrai séjour luxueux et l'emplacement était parfait pour le lac Lacanau et aussi Lacanau Ocean. Il y avait de superbes plages à moins de 5 minutes en voiture ainsi que des supermarchés et la ville de Lacanau Ocean était vraiment proche. Le lac était également à 2 minutes à pied. La maison était géniale pour une famille avec des enfants et nous avons utilisé la piscine et les sièges extérieurs tout le temps. Nous avons adoré et nous reviendrons avec plaisir.", "commentsLanguage": "en", "disclaimer": "Langue d'origine : Anglais", "needsTranslation": true, "response": null, "responseDisclaimer": null}, "rating": 5, "ratingAccessibilityLabel": "Évaluation 5 étoiles", "recommendedNumberOfLines": null, "response": "Merci beaucoup Alan! Nous étions ravis de vous accueillir et nous le ferons de nouveau avec grand plaisir si vous souhaitez revenir dans la région!", "roomTypeListingTitle": null, "highlightedReviewSentence": [], "highlightReviewMentioned": null, "showMoreButton": {"__typename": "BasicListItem", "title": "Lire la suite", "loggingEventData": {"__typename": "LoggingEventData", "loggingId": "pdp.reviews.readMore", "experiments": [], "eventData": null, "eventDataSchemaName": null, "section": null, "component": null}}, "subtitleItems": [], "channel": null, "reviewMediaItems": [], "isHostHighlightedReview": null, "reviewPhotoUrls": []}, {"__typename": "PdpReviewForP3", "collectionTag": null, "comments": "This house is in an amazing location, right opposite Le Moutchic beach. Restaurants, water sports galore. The house is lovely. Well equipped, great dinings spaces. The pool and garden are lovely. Lots of sleeping accommodation. Charlene was very helpful. Highly recommend.", "id": "945524925833453223", "language": "en", "createdAt": "2023-07-28T13:49:14Z", "reviewee": {"__typename": "ReviewUser", "deleted": false, "firstName": "Charlene", "hostName": "Charlene", "id": "400141798", "pictureUrl": "https://a0.muscache.com/im/pictures/user/05bc5c1c-e98e-4e63-be62-d9c4b535177f.jpg", "profilePath": "/users/profile/1469837611424668015", "isSuperhost": false, "userProfilePicture": {"__typename": "Image", "baseUrl": "https://a0.muscache.com/im/pictures/user/05bc5c1c-e98e-4e63-be62-d9c4b535177f.jpg", "onPressAction": {"__typename": "NavigateToUserProfile", "url": "/users/profile/1469837611424668015"}}}, "reviewer": {"__typename": "ReviewUser", "deleted": false, "firstName": "Sarah", "hostName": "Sarah", "id": "446022672", "pictureUrl": "https://a0.muscache.com/im/pictures/user/User/original/97f48293-c363-420d-9ed5-20d7bdc98b2d.jpeg", "profilePath": "/users/profile/1484531519932359096", "isSuperhost": false, "userProfilePicture": {"__typename": "Image", "baseUrl": "https://a0.muscache.com/im/pictures/user/User/original/97f48293-c363-420d-9ed5-20d7bdc98b2d.jpeg", "onPressAction": {"__typename": "NavigateToUserProfile", "url": "/users/profile/1484531519932359096"}}}, "reviewHighlight": "Séjour d'environ une semaine", "highlightType": "LENGTH_OF_STAY", "localizedDate": "juillet 2023", "localizedRespondedDate": null, "localizedReviewerLocation": "5 ans sur Airbnb", "localizedReview": {"__typename": "LocalizedReview", "comments": "Cette maison est située dans un endroit incroyable, juste en face de la plage du Moutchic. Restaurants, sports nautiques à gogo. La maison est charmante. Bien équipé, super espaces pour dîner. La piscine et le jardin sont charmants. Beaucoup de couchages. Charlene a été très serviable. Vivement recommandé.", "commentsLanguage": "en", "disclaimer": "Langue d'origine : Anglais", "needsTranslation": true, "response": null, "responseDisclaimer": null}, "rating": 5, "ratingAccessibilityLabel": "Évaluation 5 étoiles", "recommendedNumberOfLines": null, "response": null, "roomTypeListingTitle": null, "highlightedReviewSentence": [], "highlightReviewMentioned": null, "showMoreButton": {"__typename": "BasicListItem", "title": "Lire la suite", "loggingEventData": {"__typename": "LoggingEventData", "loggingId": "pdp.reviews.readMore", "experiments": [], "eventData": null, "eventDataSchemaName": null, "section": null, "component": null}}, "subtitleItems": [], "channel": null, "reviewMediaItems": [], "isHostHighlightedReview": null, "reviewPhotoUrls": []}, {"__typename": "PdpReviewForP3", "collectionTag": null, "comments": "Nous avons passé un super séjour dans la magnifique maison de Charlène. La maison est   spacieuse, agréable, bien équipée et décorée avec goût. L'extérieur et la piscine invite à la détente et au farniente. Un véritable havre de paix!", "id": "927396026220104627", "language": "fr", "createdAt": "2023-07-03T13:30:21Z", "reviewee": {"__typename": "ReviewUser", "deleted": false, "firstName": "Charlene", "hostName": "Charlene", "id": "400141798", "pictureUrl": "https://a0.muscache.com/im/pictures/user/05bc5c1c-e98e-4e63-be62-d9c4b535177f.jpg", "profilePath": "/users/profile/1469837611424668015", "isSuperhost": false, "userProfilePicture": {"__typename": "Image", "baseUrl": "https://a0.muscache.com/im/pictures/user/05bc5c1c-e98e-4e63-be62-d9c4b535177f.jpg", "onPressAction": {"__typename": "NavigateToUserProfile", "url": "/users/profile/1469837611424668015"}}}, "reviewer": {"__typename": "ReviewUser", "deleted": false, "firstName": "Damien", "hostName": "Damien", "id": "5111208", "pictureUrl": "https://a0.muscache.com/im/pictures/user/bdc249e4-ba67-4b1c-b857-8ea35fd500f5.jpg", "profilePath": "/users/profile/1478604201252830375", "isSuperhost": false, "userProfilePicture": {"__typename": "Image", "baseUrl": "https://a0.muscache.com/im/pictures/user/bdc249e4-ba67-4b1c-b857-8ea35fd500f5.jpg", "onPressAction": {"__typename": "NavigateToUserProfile", "url": "/users/profile/1478604201252830375"}}}, "reviewHighlight": "Séjour de quelques nuits", "highlightType": "LENGTH_OF_STAY", "localizedDate": "juillet 2023", "localizedRespondedDate": "juillet 2023", "localizedReviewerLocation": "14 ans sur Airbnb", "localizedReview": null, "rating": 5, "ratingAccessibilityLabel": "Évaluation 5 étoiles", "recommendedNumberOfLines": null, "response": "Merci beaucoup, c’est exactement ce que nous souhaitons pour nos hôtes! Qu’ils se sentent chez eux le temps d’un week-end où d’une semaine. Merci à vous, hôtes au top!", "roomTypeListingTitle": null, "highlightedReviewSentence": [], "highlightReviewMentioned": null, "showMoreButton": {"__typename": "BasicListItem", "title": "Lire la suite", "loggingEventData": {"__typename": "LoggingEventData", "loggingId": "pdp.reviews.readMore", "experiments": [], "eventData": null, "eventDataSchemaName": null, "section": null, "component": null}}, "subtitleItems": [], "channel": null, "reviewMediaItems": [], "isHostHighlightedReview": null, "reviewPhotoUrls": []}, {"__typename": "PdpReviewForP3", "collectionTag": null, "comments": "Super week-end passé au Moutchic. Maison impeccable, piscine et terrasse au top. Charlène est très réactive et acceuillante. <br/>La maison et le cadre, tout est parfait ! <br/>Je recomande sans hésiter.", "id": "