{
  "name": "Game",
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "Shared": {
        "$path": "src/shared"
      }
    },
    "ServerScriptService": {
      "Server": {
        "$path": "src/server"
      }
    },
    "StarterPlayer": {
      "StarterPlayerScripts": {
        "Client": {
          "$path": "src/client"
        }
      },
      "$properties": {
        "CharacterWalkSpeed": 16,
        "CharacterJumpHeight": 7.2,
        "CharacterUseJumpPower": false
      }
    },
    "Workspace": {
      "$properties": {
        "StreamingEnabled": true,
        "Gravity": 196.2
      }
    },
    "Lighting": {
      "$properties": {
        "Technology": "Future",
        "Brightness": 2.5,
        "ClockTime": 14.5,
        "GlobalShadows": true,
        "EnvironmentDiffuseScale": 1,
        "EnvironmentSpecularScale": 1
      }
    },
    "SoundService": {
      "$properties": {
        "RespectFilteringEnabled": true
      }
    }
  }
}
