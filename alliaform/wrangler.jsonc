// Configuration Cloudflare du site AlliaForm (Worker « alliaform »), séparé de
// Nuits Singulières et du Passe. Le site est servi tel quel depuis ce dossier :
// aucun programme, uniquement des fichiers statiques.
// Mise en ligne : Cloudflare → Workers & Pages → Importer le dépôt « jules »
// avec le répertoire racine « alliaform », ou à la main depuis ce dossier :
// npx wrangler deploy
{
  "name": "alliaform",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": ".",
    "not_found_handling": "404-page"
  },
  // Nom de domaine : une fois alliaform.fr géré par Cloudflare (DNS), retirer les //
  // ci-dessous pour brancher le site sur l'adresse définitive.
  // "routes": [
  //   { "pattern": "alliaform.fr", "custom_domain": true },
  //   { "pattern": "www.alliaform.fr", "custom_domain": true }
  // ],
  "workers_dev": true
}
