// Configuration Cloudflare (Worker « jules ») : le site est servi comme
// fichiers statiques depuis la racine du dépôt. Les pages générées
// (hotels/, guides/, sitemap.xml) sont déjà enregistrées dans le dépôt,
// aucune commande de build n'est donc nécessaire.
// Les fichiers internes à ne pas publier sont listés dans .assetsignore.
{
  "name": "jules",
  "compatibility_date": "2025-09-01",
  // Petit programme pour la newsletter (worker/index.js) : il ne s'exécute
  // que pour les adresses /api/*, tout le reste est servi directement.
  "main": "worker/index.js",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  // Stockage des inscriptions à la newsletter
  "kv_namespaces": [
    { "binding": "NEWSLETTER", "id": "288085767e8649c287e48b62d5d71d5b" }
  ],
  // Mesure d'audience sans cookie (pages vues, provenance, clics réservation)
  "d1_databases": [
    { "binding": "STATS", "database_name": "nuits-stats", "database_id": "0e7197cd-72dd-443f-86e0-fb50cb3162cd" }
  ],
  // Nom de domaine (acheté sur Cloudflare) : branché automatiquement à chaque
  // déploiement. L'ancienne adresse workers.dev reste active.
  "routes": [
    { "pattern": "nuitsinguliere.com", "custom_domain": true },
    { "pattern": "www.nuitsinguliere.com", "custom_domain": true }
  ],
  "workers_dev": true
}
