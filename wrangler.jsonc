// Configuration Cloudflare (Worker « jules ») : le site est servi comme
// fichiers statiques depuis la racine du dépôt. Les pages générées
// (hotels/, guides/, sitemap.xml) sont déjà enregistrées dans le dépôt,
// aucune commande de build n'est donc nécessaire.
// Les fichiers internes à ne pas publier sont listés dans .assetsignore.
{
  "name": "jules",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": ".",
    "not_found_handling": "404-page"
  },
  // Nom de domaine (acheté sur Cloudflare) : branché automatiquement à chaque
  // déploiement. L'ancienne adresse workers.dev reste active.
  "routes": [
    { "pattern": "nuitsinguliere.com", "custom_domain": true },
    { "pattern": "www.nuitsinguliere.com", "custom_domain": true }
  ],
  "workers_dev": true
}
